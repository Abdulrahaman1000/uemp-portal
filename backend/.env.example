APP_NAME="UEMP API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Database: Neon PostgreSQL. Put the real connection string ONLY in your local backend/.env (never commit it).
# Use the DIRECT (non-pooler) string: the pooled one breaks migrations. Remove "&channel_binding=require" if you get a connection error.
DB_CONNECTION=pgsql
DB_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
DB_SSLMODE=require

# File-based or in-process drivers avoid extra round trips to the remote database.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Frontend origins allowed by CORS, comma separated (used from T2.4).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8082

MAIL_MAILER=log

# Password given to every demo account by `php artisan db:seed` (default: demo123).
SEED_PASSWORD=demo123
