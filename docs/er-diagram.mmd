    USERS ||--o| STUDENTS : "profile"
    USERS ||--o| LECTURERS : "profile"
    DEPARTMENTS ||--o{ STUDENTS : enrols
    PROGRAMS ||--o{ STUDENTS : "studies"
    DEPARTMENTS ||--o{ LECTURERS : employs
    ACADEMIC_SESSIONS ||--o{ SEMESTERS : contains
    ACADEMIC_SESSIONS ||--o{ COURSE_ASSIGNMENTS : "per session"
    COURSES ||--o{ COURSE_ASSIGNMENTS : "taught via"
    LECTURERS ||--o{ COURSE_ASSIGNMENTS : teaches
